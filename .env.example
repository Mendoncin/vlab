# Configure sua chave localmente. Não versione o arquivo .env.
OPENAI_API_KEY=
# Opcional; se vazio, utiliza gpt-4o-mini.
OPENAI_MODEL=
# Opcional localmente; se vazio, utiliza .vlab/ na raiz do projeto.
# Caminhos relativos personalizados usam o diretório corrente.
# No Railway: VLAB_STORAGE_DIR=/data, com volume persistente montado em /data.
VLAB_STORAGE_DIR=
